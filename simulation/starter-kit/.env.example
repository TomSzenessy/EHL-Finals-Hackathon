# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# Your team's key from https://arena.tacto.ai/apply (one per team; never commit it)
ARENA_API_KEY=
# The unpacked data package (`arena data` puts it here; for the LLM agent and the MCP server)
ARENA_DATA=../data

# LLM for the example agent - your own key. Either Anthropic ...
LLM_PROVIDER=openai
LLM_MODEL=
LLM_EFFORT=low
ANTHROPIC_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_ENDPOINT=/chat/completions
LLM_API_KEY=
# ... or any OpenAI-compatible endpoint (OpenAI, Mistral, Groq, a local Ollama, ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
# LLM_API_KEY=

# Haggle: `uv run --extra ui arena-haggle` reads the keys above. Online needs ARENA_API_KEY; the model needs
# LLM_MODEL and LLM_API_KEY (or ANTHROPIC_API_KEY with LLM_PROVIDER=anthropic). LLM_TIMEOUT bounds one model call (s).
